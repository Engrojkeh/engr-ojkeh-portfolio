# Resend API key for the contact form.
# Create one at https://resend.com/api-keys
RESEND_API_KEY=re_your_api_key_here

# The recipient email address where contact form submissions are sent.
CONTACT_RECIPIENT_EMAIL=your-real-email@example.com

# Verified sender address. Must be a domain you own and verify in Resend,
# otherwise emails are rejected or go to test mode.
RESEND_FROM_EMAIL=onboarding@resend.dev
